# Managed by Ansible (roles/app). garmin-mcp davidlloyd weight sync (one-shot).
# Triggered by davidlloyd.timer, not enabled directly. Headless: reads the latest
# David Lloyd scale weight and writes it to Garmin Connect (which then syncs to
# Intervals). No MCP server, no public listener.
[Unit]
Description=davidlloyd weight sync (David Lloyd -> Garmin)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the garmin user: the sync reads+refreshes the garmin token store (to
# write the weigh-in) and reads the David Lloyd session store, both owned by this
# user. This couples the sync to garmin (by necessity — it needs both creds) but
# never touches intervals; the isolation rule (garmin<->intervals) is preserved.
User={{ garmin_service_user }}
Group={{ garmin_service_user }}
ExecStart={{ app_bin_dir }}/davidlloyd sync
EnvironmentFile={{ app_etc_dir }}/davidlloyd.env

# --- Hardening (commented directives need an on-box `systemd-analyze security`) -
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
# MemoryDenyWriteExecute=true
# SystemCallFilter=@system-service
# SystemCallFilter=~@privileged ~@resources
# Outbound HTTPS to Netpulse, eGym and Garmin is required.
IPAddressAllow=any
