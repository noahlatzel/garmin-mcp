# garmin-mcp local development configuration.
# Copy to .env (git-ignored) and fill in real values. Production sets these as
# real environment variables via the systemd EnvironmentFile (see ansible/).

# --- Token store -------------------------------------------------------------
# File holding persisted Garmin OAuth tokens (0600). Required in all modes.
# Populate it once with `garmin login` (reads GARMIN_EMAIL/GARMIN_PASSWORD and
# prompts for MFA; persists only tokens).
GARMIN_TOKEN_PATH=./garmin-tokens.json

# --- Transport ---------------------------------------------------------------
# Unset GARMIN_LISTEN_ADDR to serve over stdio (local MCP clients, no auth).
# Set it (e.g. 127.0.0.1:8082) to serve Streamable HTTP behind a bearer token.
# GARMIN_LISTEN_ADDR=127.0.0.1:8082

# Required in HTTP mode: the shared bearer token every request must present.
# Generate a long random value, e.g.  openssl rand -hex 32
# MCP_BEARER_TOKEN=

# --- One-time login (read only by `garmin login`; never persisted) -----------
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

# --- David Lloyd weight sync (optional; only for `davidlloyd` modes) ----------
# DAVIDLLOYD_SESSION_PATH=./davidlloyd-session.json
# DL_BRAND=
# Read only by `davidlloyd login` (never persisted):
# DL_USERNAME=
# DL_PASSWORD=
