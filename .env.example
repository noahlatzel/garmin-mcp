# Copy to .env (git-ignored) and fill in real values. The binary reads .env from
# its working directory; `docker compose` reads it for compose.yaml.

# File holding your Garmin tokens (0600). Required outside Docker; the image
# defaults it to /data/tokens.json. Populate it once with `garmin login`.
GARMIN_TOKEN_PATH=./garmin-tokens.json

# Leave GARMIN_LISTEN_ADDR unset to serve over stdio (local MCP clients, no
# auth). Set it (e.g. 127.0.0.1:8082) to serve Streamable HTTP behind a bearer
# token; compose.yaml sets it for you.
# GARMIN_LISTEN_ADDR=127.0.0.1:8082

# Required in HTTP mode: the shared bearer token every request must present.
# Generate a long random value, e.g.  openssl rand -hex 32
# MCP_BEARER_TOKEN=

# Read only by `garmin login`; never persisted.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
